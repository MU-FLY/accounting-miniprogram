page {
  --primary: #4A90D9;
  --primary-light: #E8F4FD;
  --income: #36e691;
  --expense: #FF6B6B;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-tertiary: #999999;
  --bg-gray: #F5F5F5;
  --border: #EEEEEE;
  --white: #FFFFFF;
  --shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  --radius: 16rpx;
  --radius-lg: 24rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: var(--bg-gray);
  color: var(--text-primary);
}

.container {
  padding: 20rpx;
}

.card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.btn-primary {
  background: var(--primary);
  color: var(--white);
  border-radius: var(--radius);
  padding: 24rpx 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.btn-primary::after {
  border: none;
}

.text-income {
  color: var(--income);
}

.text-expense {
  color: var(--expense);
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.text-center {
  text-align: center;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: var(--text-tertiary);
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--text-tertiary);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}
