/* 首页整体 */
.container {
  padding: 20rpx;
  background: #f5f6fa;
  min-height: 100vh;
}

/* 头部卡片 - 蓝色渐变 */
.header-card {
  background: linear-gradient(135deg, #4A7BF7 0%, #6B8EF9 50%, #8566e3 100%);
  border-radius: 24rpx;
  padding: 30rpx;
  color: #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(91, 124, 249, 0.3);
}

/* 月份导航 */
.month-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.nav-arrow {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.8);
}

.month-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 结余行 */
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.15);
}

.summary-row:last-of-type {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.summary-left {
  flex: 1;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.summary-amount {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.summary-right {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: flex-start;
  padding-left: 20rpx;
  border-left: 2rpx solid rgba(255, 255, 250, 0.3);
}

.income-row, .expense-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dot {
  width: 6rpx;
  height: 20rpx;
  border-radius: 3rpx;
}

.income-dot {
  background: #e4fff2;
}

.expense-dot {
  background: #FF6B6B;
}

.summary-right .summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  min-width: 48rpx;
}

.income-amount {
  color: #a8f5c8;
  font-size: 28rpx;
  font-weight: 500;
  min-width: 140rpx;
  text-align: right;
}

.expense-amount {
  color: #ffb3b3;
  font-size: 28rpx;
  font-weight: 500;
  min-width: 140rpx;
  text-align: right;
}

/* 今日统计 */
.today-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-top: 20rpx;
}

/* 操作提示 */
.tip-bar {
  display: flex;
  align-items: center;
  background: #E6F7FF;
  border: 1rpx solid #91D5FF;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #1890FF;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.stat-num.income {
  color: #7bfbbd;
}

.stat-num.expense {
  color: #ffb3b3;
}

.stat-num.save {
  color: #7bfbbd;
  text-shadow: 0 0 10rpx rgba(123, 251, 189, 0.3);
}

.daily-save {
  background: rgba(88, 214, 141, 0.15);
  border-radius: 16rpx;
  padding: 8rpx 0;
  margin: 0 8rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.15);
}

/* 文字颜色 */
.text-income {
  color: #07c160;
}

.text-expense {
  color: #ff4d4f;
}

/* 账单列表 */
.bill-list {
  padding-bottom: 40rpx;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 10rpx;
}

.date-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.date-summary {
  display: flex;
  gap: 16rpx;
  font-size: 24rpx;
}

.date-expense {
  color: #ff4d4f;
}

.date-income {
  color: #07c160;
}

.bill-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid transparent;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  transform: scale(1);
}

.bill-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f5f7fa 0%, #eef1f5 100%);
  border-radius: 24rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.04);
  position: relative;
  overflow: hidden;
}

.bill-icon::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0) 50%);
  border-radius: 24rpx;
}

.icon-text {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
}

.bill-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.bill-category {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
}

.bill-time {
  font-size: 20rpx;
  color: #c0c4cc;
}

.bill-remark {
  font-size: 24rpx;
  color: #606266;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: 600;
  text-align: right;
  min-width: 120rpx;
}

.amount {
  font-weight: 600;
  letter-spacing: -0.5rpx;
}

/* 添加按钮 */
.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #4A7BF7 0%, #6B8EF9 50%, #9B7BFF 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(91, 124, 249, 0.4);
  z-index: 100;
}

.add-icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #999;
}

/* 批量删除工具栏 */
.batch-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.batch-left {
  display: flex;
  align-items: center;
}

.batch-select-all {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.batch-select-text {
  font-size: 28rpx;
  color: #333;
  margin-left: 12rpx;
  font-weight: 500;
}

.batch-info {
  font-size: 28rpx;
  color: #FF6B6B;
  font-weight: 600;
}

.batch-actions {
  display: flex;
  align-items: center;
}

.batch-cancel {
  font-size: 28rpx;
  color: #999;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
}

.batch-delete {
  font-size: 28rpx;
  color: #fff;
  padding: 12rpx 28rpx;
  background: #FF4D4F;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 删除警告 */
.delete-warning {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFF7E6;
  border: 2rpx solid #FFD591;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.warning-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.warning-text {
  font-size: 26rpx;
  color: #D46B08;
  line-height: 1.4;
  flex: 1;
}

/* 批量模式下的账单项 */
.bill-item.batch-mode {
  opacity: 0.85;
  position: relative;
}
.bill-item.batch-mode.selected {
  opacity: 1;
}

/* 选中状态 - 蓝色主题 */
.bill-item.selected {
  background-color: #E6F7FF !important;
  border: 4rpx solid #1890FF !important;
  transform: scale(1.02);
  box-shadow: 0 4rpx 24rpx rgba(24, 144, 255, 0.4);
  position: relative;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
.bill-item.selected .bill-content {
  border-radius: 12rpx;
}
.bill-item.selected::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 144, 255, 0.08);
  pointer-events: none;
  z-index: 1;
  border-radius: 16rpx;
}

.bill-checkbox {
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 勾选框默认样式 */
.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #d9d9d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  background: #fff;
}

/* 选中后的勾选框 - 蓝色背景+白色对勾 */
.checkbox.checked {
  background: #1890FF;
  border-color: #1890FF;
  box-shadow: 0 0 20rpx rgba(24, 144, 255, 0.6);
  transform: scale(1.1);
}

.check-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
}

/* 选中动画 */
.checkbox.checked .check-icon {
  animation: checkPop 0.3s ease;
}

@keyframes checkPop {
  0% { transform: scale(0); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.bill-content {
  flex: 1;
  display: flex;
  align-items: center;
}

/* 错误提示 */
.error-msg {
  background: #FFF2F0;
  border: 1rpx solid #FFCCC7;
  color: #FF4D4F;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}