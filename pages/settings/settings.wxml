<view class="container">
  <!-- User Card -->
  <view class="card user-card">
    <view class="user-info" wx:if="{{!userInfo}}" bindtap="showAuthModal">
      <view class="avatar">
        <text>👤</text>
      </view>
      <view class="user-detail">
        <text class="user-name">点击登录</text>
        <text class="user-sub">点击获取微信头像和昵称</text>
      </view>
      <text class="arrow-right">›</text>
    </view>
    <view class="user-info" wx:if="{{userInfo}}">
      <view class="avatar">
        <image src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      </view>
      <view class="user-detail">
        <text class="user-name">{{userInfo.nickName}}</text>
        <text class="user-sub">已登录</text>
      </view>
    </view>
  </view>

  <!-- Auth Modal -->
  <view class="auth-modal {{showAuth ? 'show' : ''}}">
    <view class="auth-mask" bindtap="hideAuthModal"></view>
    <view class="auth-content">
      <view class="auth-title">授权获取微信信息</view>
      <view class="auth-desc">请完善您的头像和昵称</view>
      <view class="auth-form">
        <button class="auth-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <view class="auth-avatar">
            <text wx:if="{{!userInfo.avatarUrl}}">👤</text>
            <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
          </view>
          <text class="auth-avatar-text">点击获取头像</text>
        </button>
        <input type="nickname" class="auth-nickname-input" placeholder="点击获取微信昵称" value="{{userInfo.nickName}}" bindblur="onNicknameChange" bindinput="onNicknameInput" />
      </view>
      <view class="auth-buttons">
        <button class="auth-cancel" bindtap="hideAuthModal">
          <text class="btn-icon">✕</text>
          <text>取消登录</text>
        </button>
        <button class="auth-confirm" bindtap="confirmAuth">
          <text class="btn-icon">✓</text>
          <text>确定登录</text>
        </button>
      </view>
    </view>
  </view>

  <!-- Stats Grid -->
  <view class="card stats-grid">
    <view class="stats-row">
      <view class="stats-item">
        <text class="stats-value">{{billCount}}</text>
        <text class="stats-label">记账笔数</text>
      </view>
      <view class="stats-item">
        <text class="stats-value">{{totalDays}}</text>
        <text class="stats-label">记账天数</text>
      </view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-row">
      <view class="stats-item">
        <text class="stats-value text-income">{{totalIncome}}</text>
        <text class="stats-label">累计收入</text>
      </view>
      <view class="stats-item">
        <text class="stats-value text-expense">{{totalExpense}}</text>
        <text class="stats-label">累计支出</text>
      </view>
    </view>
  </view>

  <!-- Menu List -->
  <view class="card menu-list">
    <!-- 数据管理 -->
    <view class="menu-section-title">数据管理</view>
    <view class="menu-item" bindtap="showExportModal">
      <view class="menu-icon icon-export">📋</view>
      <text class="menu-text">一键导出</text>
      <text class="arrow-right">›</text>
    </view>
    <view class="menu-item" bindtap="showImportModal">
      <view class="menu-icon icon-import">📂</view>
      <text class="menu-text">一键导入</text>
      <text class="arrow-right">›</text>
    </view>
    <view class="menu-item" bindtap="syncData">
      <view class="menu-icon icon-sync">🔄</view>
      <text class="menu-text">同步云端数据</text>
      <text class="arrow-right">›</text>
    </view>
    <view class="menu-item" bindtap="uploadToCloud">
      <view class="menu-icon icon-upload">☁️</view>
      <text class="menu-text">一键上传云端</text>
      <text class="arrow-right">›</text>
    </view>

    <!-- 工具 -->
    <view class="menu-section-title">工具</view>
    <view class="menu-item" bindtap="openAutoSaveSetting">
      <view class="menu-icon icon-save">💰</view>
      <text class="menu-text">每日一攒</text>
      <view class="menu-status" wx:if="{{autoSaveEnabled}}">
        <view class="status-badge active">
          <text class="status-dot"></text>
          <text class="status-text">已开启</text>
        </view>
      </view>
      <view class="menu-status" wx:if="{{!autoSaveEnabled}}">
        <view class="status-badge">
          <text class="status-text">未开启</text>
        </view>
      </view>
      <text class="arrow-right">›</text>
    </view>

    <!-- 设置 -->
    <view class="menu-section-title">设置</view>
    <view class="menu-item" bindtap="clearData">
      <view class="menu-icon icon-clear">🧹</view>
      <text class="menu-text">清除本地缓存</text>
      <text class="arrow-right">›</text>
    </view>
    <view class="menu-item menu-item-danger" bindtap="resetAllData">
      <view class="menu-icon icon-danger">🗑️</view>
      <text class="menu-text">一键清理云端</text>
      <text class="arrow-right">›</text>
    </view>
    <view class="menu-item" bindtap="goFeedback">
      <view class="menu-icon icon-feedback">✉️</view>
      <text class="menu-text">意见反馈</text>
      <text class="arrow-right">›</text>
    </view>
    <view class="menu-item" bindtap="followOfficialAccount">
      <view class="menu-icon icon-official">
        <image src="/images/official-account.png" mode="aspectFill" class="official-icon-img" />
      </view>
      <text class="menu-text">关注公众号</text>
      <text class="arrow-right">›</text>
    </view>
    <view class="menu-item menu-item-danger" bindtap="logout" wx:if="{{userInfo}}">
      <view class="menu-icon icon-logout">🚪</view>
      <text class="menu-text">退出登录</text>
      <text class="arrow-right">›</text>
    </view>

    <!-- 关于 -->
    <view class="menu-section-title">关于</view>
    <view class="menu-item" bindtap="goAbout">
      <view class="menu-icon icon-about">ⓘ</view>
      <text class="menu-text">关于随手记</text>
      <text class="arrow-right">›</text>
    </view>
  </view>

  <!-- Progress Modal -->
  <view class="progress-modal {{showProgress ? 'show' : ''}}">
    <view class="progress-mask"></view>
    <view class="progress-content">
      <view class="progress-title">{{progressTitle}}</view>
      <view class="progress-bar-container">
        <view class="progress-bar-bg">
          <view class="progress-bar-fill" style="width: {{progressPercent}}%;"></view>
        </view>
        <view class="progress-percent">{{progressPercent}}%</view>
      </view>
      <view class="progress-text">{{progressText}}</view>
    </view>
  </view>

  <!-- Export Modal -->
  <view class="export-modal {{showExportModal ? 'show' : ''}}">
    <view class="export-mask" bindtap="closeExportModal"></view>
    <view class="export-content">
      <view class="export-header">
        <view class="modal-icon">📤</view>
        <view class="export-title">导出数据</view>
        <view class="export-subtitle">将账单数据导出为 JSON 文件</view>
      </view>
      <view class="export-info">
        <view class="info-item">
          <text class="info-label">导出内容</text>
          <text class="info-value">账单记录、分类设置、每日一攒配置</text>
        </view>
        <view class="info-item">
          <text class="info-label">文件格式</text>
          <text class="info-value">JSON (.json)</text>
        </view>
        <view class="info-item">
          <text class="info-label">编码格式</text>
          <text class="info-value">UTF-8</text>
        </view>
      </view>
      <view class="export-buttons">
        <button class="modal-btn modal-cancel" bindtap="closeExportModal">取消</button>
        <button class="modal-btn modal-confirm" bindtap="exportData">确认导出</button>
      </view>
    </view>
  </view>

  <!-- Import Modal -->
  <view class="import-modal {{showImportModal ? 'show' : ''}}">
    <view class="import-mask" bindtap="closeImportModal"></view>
    <view class="import-content">
      <view class="import-header">
        <view class="modal-icon">📥</view>
        <view class="import-title">导入数据</view>
        <view class="import-subtitle">从 JSON 文件导入账单数据</view>
      </view>
      <view class="import-format">
        <view class="format-title">📋 数据格式要求</view>
        <scroll-view class="format-content" scroll-y>
          <text class="format-text">{{importFormatHint}}</text>
        </scroll-view>
      </view>
      <view class="import-buttons">
        <button class="modal-btn modal-cancel" bindtap="closeImportModal">取消</button>
        <button class="modal-btn modal-confirm" bindtap="chooseAndImportFile">选择文件导入</button>
      </view>
    </view>
  </view>

  <!-- Auto Save Modal -->
  <view class="auto-save-modal {{showAutoSaveModal ? 'show' : ''}}">
    <view class="auto-save-mask" bindtap="closeAutoSaveModal"></view>
    <view class="auto-save-modal-content">
      <view class="auto-save-modal-header">
        <view class="modal-icon">💰</view>
        <view class="auto-save-modal-title">每日一攒</view>
        <view class="modal-subtitle" wx:if="{{!autoSaveEnabled}}">设置自动攒入金额和时间</view>
        <view class="modal-subtitle" wx:if="{{autoSaveEnabled}}">当前设置：¥{{autoSaveAmount}} · {{autoSaveTime}}</view>
      </view>
      <view class="auto-save-form">
        <view class="form-item">
          <text class="form-label">每日攒入金额</text>
          <view class="form-input-wrap">
            <text class="form-prefix">¥</text>
            <input class="form-input" type="digit" value="{{autoSaveAmount}}" bindinput="setAutoSaveAmount" placeholder="请输入金额"/>
          </view>
        </view>
        <view class="form-item">
          <text class="form-label">执行时间</text>
          <picker mode="time" value="{{autoSaveTime}}" bindchange="setAutoSaveTime">
            <view class="form-picker">
              <text class="picker-icon">🕐</text>
              <text class="picker-value">{{autoSaveTime}}</text>
            </view>
          </picker>
        </view>
      </view>
      <view class="auto-save-modal-buttons">
        <button class="modal-btn modal-cancel" bindtap="closeAutoSaveModal">取消</button>
        <button class="modal-btn modal-confirm" bindtap="saveAutoSaveSettings">保存设置</button>
      </view>
      <view class="auto-save-close" wx:if="{{autoSaveEnabled}}">
        <text class="close-text" bindtap="disableAutoSave">关闭每日一攒</text>
      </view>
    </view>
  </view>

  <!-- Feedback Modal -->
  <view class="feedback-modal {{showFeedback ? 'show' : ''}}">
    <view class="feedback-mask" bindtap="hideFeedbackModal"></view>
    <view class="feedback-content">
      <view class="feedback-title">意见反馈</view>
      <view class="feedback-body">
        <text class="feedback-text">如有问题或建议，请联系开发者</text>
        <text class="feedback-email">邮箱：501148193@qq.com</text>
      </view>
      <view class="feedback-buttons">
        <button class="feedback-confirm" bindtap="hideFeedbackModal">
          <text>知道了</text>
        </button>
      </view>
    </view>
  </view>

  <!-- Official Account Modal -->
  <view class="official-modal {{showOfficialModal ? 'show' : ''}}">
    <view class="official-mask" bindtap="closeOfficialModal"></view>
    <view class="official-content">
      <view class="official-header">
        <view class="official-title">关注公众号</view>
        <view class="official-subtitle">长按识别二维码关注</view>
      </view>
      <view class="official-image-wrap">
        <image src="/images/official-account.png" mode="aspectFit" class="official-qrcode" show-menu-by-longpress />
      </view>
      <view class="official-tip">长按图片识别二维码关注公众号</view>
      <view class="official-buttons">
        <button class="modal-btn modal-cancel" bindtap="closeOfficialModal">关闭</button>
        <button class="modal-btn modal-confirm" bindtap="copyOfficialName">复制名称</button>
      </view>
    </view>
  </view>

  <!-- Version -->
  <view class="version">版本 2.4.0</view>
</view>