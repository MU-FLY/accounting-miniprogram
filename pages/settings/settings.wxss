.user-card {
  padding: 30rpx;
}

/* Override income/expense colors to match home page */
.text-income {
  color: #36e691 !important;
}

.text-expense {
  color: #FF6B6B !important;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  margin-right: 24rpx;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

/* Auth Modal */
.auth-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
}

.auth-modal.show {
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.auth-content {
  position: relative;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 600rpx;
  text-align: center;
}

.auth-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.auth-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}

.auth-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  margin-bottom: 40rpx;
}

.auth-avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.auth-avatar-btn::after {
  border: none;
}

.auth-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.auth-avatar image {
  width: 100%;
  height: 100%;
}

.auth-avatar-text {
  font-size: 24rpx;
  color: var(--primary);
}

.auth-nickname-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  text-align: center;
  background: var(--bg-secondary);
}

.auth-buttons {
  display: flex;
  gap: 20rpx;
}

.auth-cancel, .auth-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0;
}

.auth-cancel {
  background: #f5f5f5;
  color: #666;
}

.auth-confirm {
  background: linear-gradient(135deg, #07c160, #10b981);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.auth-cancel::after, .auth-confirm::after {
  border: none;
}

.btn-icon {
  font-size: 28rpx;
}

.user-name-input {
  display: block !important;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  background: transparent;
  border: none;
  padding: 0;
  width: 100%;
  height: 48rpx;
  line-height: 48rpx;
  position: relative;
  z-index: 1;
}

.user-name-input::after {
  border: none;
  display: none;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  overflow: hidden;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.user-detail {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.user-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.arrow-right {
  font-size: 40rpx;
  color: var(--text-tertiary);
}

/* Stats Grid */
.stats-grid {
  padding: 30rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stats-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}

.stats-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.stats-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stats-divider {
  height: 1rpx;
  background: var(--border);
  margin: 10rpx 0;
}

/* Menu List */
.menu-list {
  padding: 0 30rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--primary-light);
}

/* Icon colors by category */
.icon-export {
  background: #e3f2fd;
}

.icon-import {
  background: #f3e5f5;
}

.icon-sync {
  background: #e8f5e9;
}

.icon-upload {
  background: #e0f7fa;
}

.icon-save {
  background: #fff3e0;
}

.icon-clear {
  background: #f5f5f5;
}

.icon-danger {
  background: #ffebee;
}

.icon-feedback {
  background: #e8eaf6;
}

.icon-official {
  background: #fce4ec;
  padding: 0;
  overflow: hidden;
}

.official-icon-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.icon-logout {
  background: #ffebee;
}

.icon-about {
  background: #e0f2f1;
}
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-value {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.menu-status {
  margin-right: 16rpx;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #f5f5f5;
  border: 1rpx solid #e0e0e0;
}

.status-badge.active {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border-color: #81c784;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #4caf50;
  margin-right: 10rpx;
  box-shadow: 0 0 8rpx rgba(76, 175, 80, 0.4);
}

.status-text {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.status-badge.active .status-text {
  color: #2e7d32;
}

/* Progress Modal */

.progress-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  display: none;
}

.progress-modal.show {
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.progress-content {
  position: relative;
  background: white;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  width: 80%;
  max-width: 600rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.progress-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 40rpx;
}

.progress-bar-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.progress-bar-bg {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #c8f0c5, #a8e6a3);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: #7dd87b;
  min-width: 60rpx;
  text-align: right;
}

.progress-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
}

/* Feedback Modal */
.feedback-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
}

.feedback-modal.show {
  display: flex;
