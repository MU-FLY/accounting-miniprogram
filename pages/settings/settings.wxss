}

.feedback-content {
  position: relative;
  background: white;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  width: 90%;
  max-width: 700rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.feedback-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 40rpx;
}

.feedback-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 50rpx;
}

.feedback-text {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.feedback-email {
  font-size: 30rpx;
  color: var(--primary);
  font-weight: 500;
  line-height: 1.6;
}

.feedback-buttons {
  display: flex;
  justify-content: center;
}

.feedback-confirm {
  width: 80%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  background: linear-gradient(135deg, #07c160, #10b981);
  color: white;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
}

.feedback-confirm::after {
  border: none;
}

/* Version */
.version {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* Auto Save Modal */
.auto-save-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
}

.auto-save-modal.show {
  display: flex;
  align-items: center;
  justify-content: center;
}

.auto-save-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
}

.auto-save-modal-content {
  position: relative;
  background: white;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  width: 82%;
  max-width: 600rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  animation: modalSlideUp 0.3s ease;
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.auto-save-modal-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.modal-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.auto-save-modal-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.modal-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}

.auto-save-form {
  margin-bottom: 48rpx;
}

.form-item {
  margin-bottom: 36rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
  font-weight: 500;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.form-input-wrap:focus-within {
  background: #fff;
  border-color: #58D68D;
  box-shadow: 0 0 0 4rpx rgba(88, 214, 141, 0.15);
}

.form-prefix {
  font-size: 36rpx;
  color: #58D68D;
  margin-right: 16rpx;
  font-weight: 700;
}

.form-input {
  flex: 1;
  font-size: 34rpx;
  color: var(--text-primary);
  height: 96rpx;
  background: transparent;
  font-weight: 600;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  color: var(--text-primary);
  text-align: center;
  font-weight: 600;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.form-picker:active {
  background: #fff;
  border-color: #58D68D;
}

.picker-icon {
  font-size: 32rpx;
}

.picker-value {
  font-size: 34rpx;
  font-weight: 600;
}

.auto-save-modal-buttons {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.modal-btn::after {
  border: none;
}

.modal-btn:active {
  transform: scale(0.96);
}

.modal-cancel {
  background: #f5f5f5;
  color: #999;
}

.modal-cancel:active {
  background: #ebebeb;
}

.modal-confirm {
  background: linear-gradient(135deg, #58D68D, #2ECC71);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(88, 214, 141, 0.35);
}

.modal-confirm:active {
  box-shadow: 0 4rpx 12rpx rgba(88, 214, 141, 0.25);
}

.auto-save-close {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.close-text {
  font-size: 28rpx;
  color: #ff4d4f;
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.close-text:active {
  background: #fff2f0;
}
/* Menu Section Title */
.menu-section-title {
  font-size: 26rpx;
  color: var(--text-tertiary);
  padding: 24rpx 0 12rpx;
  font-weight: 500;
